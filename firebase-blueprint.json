{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Product categories like Pure Tea, Milk Tea, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "englishName": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "order"]
    },
    "Product": {
      "title": "Product",
      "description": "Individual tea items",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "englishName": { "type": "string" },
        "categoryId": { "type": "string" },
        "priceM": { "type": "number" },
        "priceL": { "type": "number" },
        "isPopular": { "type": "boolean" },
        "isHot": { "type": "boolean" },
        "description": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["name", "categoryId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer tea orders",
      "type": "object",
      "properties": {
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "completed", "cancelled"] },
        "customerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["items", "total", "status", "createdAt"]
    }
  },
  "firestore": {
    "categories": {
      "schema": "Category",
      "description": "Collection of product categories"
    },
    "products": {
      "schema": "Product",
      "description": "Collection of tea products"
    },
    "orders": {
      "schema": "Order",
      "description": "Collection of customer orders"
    }
  }
}
