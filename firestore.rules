rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // In a real app, you'd check a dedicated 'admins' collection or a custom claim
      // For this app, we'll allow an 'admin' role if the user's UID is in an admins collection
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Products ---
    match /products/{productId} {
      allow read: if true; // Anyone can browse items
      allow write: if isAdmin() && isValidProduct(request.resource.data);
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.available is bool;
    }

    // --- Orders ---
    match /orders/{orderId} {
      // Anyone can create an order (customer)
      allow create: if isValidOrder(request.resource.data);
      // Only admins can see and update orders
      allow read, update: if isAdmin();
      // No deletions allowed for audit trail
      allow delete: if false;
    }

    function isValidOrder(data) {
      return data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    // --- Admins (system collection) ---
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Only manageable via console for security
    }
  }
}
