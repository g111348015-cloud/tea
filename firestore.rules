rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }
    
    // Admin check - simple for this prototype, check if user exists in an "admins" collection
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 1. Categories (Public read, Admin write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Products (Public read, Admin write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Orders (Auth required to create, Admin to read all/update)
    match /orders/{orderId} {
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && isValidOrderUpdate(incoming());
      allow delete: if isAdmin();
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['items', 'total', 'status', 'createdAt', 'uid']) &&
             data.status == 'pending' &&
             data.total is number &&
             data.total >= 0 &&
             data.items is list &&
             data.items.size() > 0 &&
             data.uid == request.auth.uid;
    }

    function isValidOrderUpdate(data) {
      return data.status in ['pending', 'preparing', 'completed', 'cancelled'] &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // 4. Admin setup (Allow self-setup for demo purposes)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
